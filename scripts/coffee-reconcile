#!/bin/bash
#
# coffee reconcile — runs once at login (an `at: login` schedule), then exits.
#
# The supervisor's EXIT trap restores `pmset disablesleep 0` on every clean
# shutdown path. It cannot cover SIGKILL, a panic, or a hard power loss. In
# those cases the Mac is left unable to sleep, system-wide and indefinitely,
# with nothing on screen to explain why.
#
# This is the sweeper for exactly that case. It is intentionally dumb: if sleep
# is disabled at login and no supervisor is running to own that state, restore
# it. Being wrong here is cheap (the supervisor re-disables within one poll);
# not running is expensive (a machine that never sleeps again).
#
set -uo pipefail

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

# Captured rather than piped into `grep -q`, for the same reason as on_ac() in
# coffee-supervisor: under pipefail, grep -q closing the pipe early makes ioreg
# take SIGPIPE and the pipeline intermittently reports failure. Here that would
# read as "sleep is not disabled" and silently skip the cleanup this service
# exists to perform.
sleep_disabled() {
  local out
  out="$(/usr/sbin/ioreg -r -k SleepDisabled -d 1 2>/dev/null)"
  case "$out" in
    *'"SleepDisabled" = Yes'*) return 0 ;;
    *) return 1 ;;
  esac
}

status=0
if sleep_disabled; then
  log "found SleepDisabled=Yes at login — clearing orphaned disablesleep"
  if sudo -n /usr/bin/pmset -a disablesleep 0 2>/dev/null; then
    log "sleep restored"
  else
    log "ERROR could not restore sleep — run: sudo pmset -a disablesleep 0"
    status=1
  fi
fi

# `autostart` means coffee turns itself on at login. The daemon is a manual
# service, so this login run is what starts it; the daemon itself then seeds
# `enabled` from `autostart`.
CONFIG="${COFFEE_CONFIG:-${BARRY_BAG_DATA_DIR:-}/coffee.json}"
if [[ -n "${BARRY_BAG_DATA_DIR:-}" ]] \
  && [[ "$(/usr/bin/plutil -extract autostart raw -o - -- "$CONFIG" 2>/dev/null)" == "true" ]]; then
  if "${BARRY_BIN:-barry}" service start coffee.daemon >/dev/null 2>&1; then
    log "autostart on — started coffee.daemon"
  else
    log "ERROR autostart on, but coffee.daemon would not start: barry service start coffee.daemon"
    status=1
  fi
fi
exit "$status"
